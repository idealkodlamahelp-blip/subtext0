GEMINI_API_KEY=your_gemini_api_key_here

# Optional: point a deployment without its own key at a configured AI endpoint
VITE_AI_SEARCH_URL=

# Optional: real Google Identity Services button (public Client ID, no secret)
VITE_GOOGLE_CLIENT_ID=337534559219-fb2vnn8k0rpjbjk721nsat2c24fc6fq8.apps.googleusercontent.com

# Real email sign-in codes via Resend (server-side only)
RESEND_API_KEY=
# Verified sending domain/address. Sandbox default: Subtext <onboarding@resend.dev>
EMAIL_FROM=Subtext <onboarding@resend.dev>
# Optional HMAC secret for stateless code tokens; falls back to RESEND_API_KEY
EMAIL_CODE_SECRET=

# Optional: use one configured email endpoint from another deployment
VITE_EMAIL_API_URL=

# Phone verification for adding books (server-side only).
# Real SMS via Twilio; without these the endpoint runs in demo mode and returns
# the code in the response so the flow still works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional HMAC secret for phone tokens; falls back to EMAIL_CODE_SECRET / Twilio token
PHONE_CODE_SECRET=
# Set to 0 to disable demo mode (then unconfigured Twilio blocks verification)
SMS_DEMO_MODE=1
# Optional: use one configured phone endpoint from another deployment
VITE_PHONE_API_URL=
# Optional: use one configured book-AI endpoint from another deployment
VITE_BOOK_AI_URL=

# Optional: comma-separated origins/deployments allowed to call /api/search and /api/email-code
# Same-origin requests are always allowed.
ALLOWED_ORIGINS=https://subtext-swart.vercel.app,https://subtext00.vercel.app,http://localhost:5173
